**/target/
# Cargo.lock is tracked — required by nix/crane builds
# /vendor — dead nested submodule chain (rc4/rc5 leftover); 2.6 GB of stale
# logos-delivery-module + lez-rln copies. Carries an outdated logos_rln_module
# .cpp with the legacy send_public_transaction(json) call — port-hazard if a
# future submodule init re-references it. Ignored to prevent re-creation.
/vendor/
# lssa and spel are consumed as pinned git deps (see lez-rln/Cargo.toml and
# methods/guest/Cargo.toml); a local working copy is no longer needed to build.
# Ignored so a stray sibling checkout can't be accidentally committed.
/lssa/
/spel/
# dev.sh provisions the pinned sequencer source into a cache. Default lives under
# $XDG_CACHE_HOME; only the repo-local override path needs ignoring here.
dev/.sequencer-src/
storage.json
wallet_config.json
dev/storage.json
dev/wallet_config.json
# Deployment descriptors include a wallet for the shared team instance.
# Track those explicitly; per-run ephemeral wallets stay ignored.
!deployments/*/storage.json
# testnet/ flat fixtures are staged from deployments/<name>/ by
# tools/deployments/stage.sh. Descriptors are tracked; staged output is not.
/testnet/
dev/logs/
.DS_Store
result
result-*
.mcp.json
.mcp_data/
